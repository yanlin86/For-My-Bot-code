# MyApp website — managed by Bot Manager (Website tab).
# Deploy overwrites /etc/nginx/sites-available/myapp with this file
# (domain substituted for __DOMAIN__). Do not edit by hand on the VPS.
server {
    listen 80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/myapp;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    root /var/www/myapp;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # APK downloads must arrive as files, not open in the browser.
    location ~ ^/apks/(.+\.apk)$ {
        add_header Content-Disposition 'attachment; filename="$1"';
        try_files $uri =404;
    }
}
